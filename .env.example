# Base de datos (Supabase, Neon, o Postgres local vía docker-compose.yml)
DATABASE_URL="postgresql://lazofood:lazofood@localhost:5432/lazofood?schema=public"

# Auth
NEXTAUTH_SECRET="genera-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business API (Twilio o 360dialog) - fase 2
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Facturación electrónica (Nubefact / Bizlinks / Efact) - fase 2
BILLING_PROVIDER_API_KEY=""
BILLING_PROVIDER_RUC=""

# Pasarela de pagos (Culqi / Izipay) - fase 2
PAYMENTS_PUBLIC_KEY=""
PAYMENTS_SECRET_KEY=""
